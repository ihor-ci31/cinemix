# Порт HTTP-сервера
PORT=3000
# Шлях до файлу бази SQLite (відносно кореня проєкту)
DB_FILE=data/cinemix.db
# Секрет для підпису JWT — замініть на довгий випадковий рядок
JWT_SECRET=change-me-to-a-long-random-string
# Час життя токена
JWT_EXPIRES_IN=7d
# Дані адміністратора, який створюється командою npm run db:init
ADMIN_EMAIL=admin@cinemix.local
ADMIN_PASSWORD=Admin12345
